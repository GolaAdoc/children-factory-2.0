{
  "name": "@webstore/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS API",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "prisma": "dotenv -e ../../.env -- prisma",
    "generate": "prisma generate --allow-no-models",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:local": "node --env-file=../../.env dist/main.js",
    "test": "jest --selectProjects unit",
    "test:e2e": "dotenv -e ../../.env -- jest --selectProjects e2e",
    "db:seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.7",
    "@prisma/client": "^6.19.3",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.7",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.4",
    "@types/supertest": "^6.0.3",
    "dotenv-cli": "^11.0.0",
    "jest": "^30.5.2",
    "prisma": "^6.19.3",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "typescript": "^5.9.3"
  },
  "jest": {
    "projects": [
      {
        "displayName": "unit",
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "moduleFileExtensions": [
          "js",
          "json",
          "ts"
        ],
        "transform": {
          "^.+\\.ts$": "ts-jest"
        },
        "testEnvironment": "node"
      },
      {
        "displayName": "e2e",
        "rootDir": "test",
        "testRegex": ".*\\.e2e-spec\\.ts$",
        "moduleFileExtensions": [
          "js",
          "json",
          "ts"
        ],
        "transform": {
          "^.+\\.ts$": "ts-jest"
        },
        "testEnvironment": "node"
      }
    ]
  }
}
