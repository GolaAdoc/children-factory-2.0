# Copy to .env (never commit .env). Use alphanumeric passwords only: they are embedded in URLs.
POSTGRES_DB=webstore
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_bootstrap
MIGRATOR_DB_PASSWORD=change_me_migrator
APP_DB_PASSWORD=change_me_app

# Runtime connection (least-privilege role webstore_app). Used by the API from P1B.
DATABASE_URL=postgresql://webstore_app:change_me_app@127.0.0.1:5432/webstore?schema=public
# Migration connection (DDL role webstore_migrator). Used only by the Prisma CLI, never by the running app.
MIGRATE_DATABASE_URL=postgresql://webstore_migrator:change_me_migrator@127.0.0.1:5432/webstore?schema=public

# Cache (P3). URL-safe secret, generate with: openssl rand -hex 32
REDIS_PASSWORD=

# Auth
JWT_ACCESS_SECRET=12345678901234567890123456789012
JWT_ACCESS_TTL_SECONDS=900
